# Supabase project (server-side only)
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATEMENTS_BUCKET=statements

# Shared secret used by the Next.js server when submitting jobs.
PROCESSOR_API_KEY=change-me-to-a-long-random-value

# Processing
# Container port. Set PORT=8000 in the Vercel project environment so Vercel
# routes container traffic to Uvicorn.
PORT=8000
# embedded = run jobs inside this FastAPI process (local/preview)
# queued = leave jobs for the processor-worker daemon (Vercel production)
# When unset, production defaults to queued and other environments to embedded.
PROCESSING_MODE=embedded
WORKER_POLL_SECONDS=2
PROCESSOR_WORKERS=2
MAX_PAGES=100
MAX_FILE_MB=25
OCR_ENABLED=true
TESSERACT_CMD=
OCR_DPI=300
TESSERACT_LANG=eng
# Jobs stuck in processing longer than this are marked failed at worker startup.
STALE_JOB_MINUTES=20
