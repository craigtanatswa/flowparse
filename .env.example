# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used for billing customer linking and webhook processing;
# bypasses RLS. Never expose it to the browser or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Processing service (server-side only; never expose this key to the browser)
# Local development only. On Vercel, PROCESSOR_URL is injected by the app ->
# processor service binding; do not set PROCESSOR_URL in the Vercel project.
PROCESSOR_URL=
PROCESSOR_API_KEY=

# Optional: site URL for auth confirmation redirects and checkout return URLs
# (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# Dodo Payments billing. Test mode is the default; live mode requires an explicit
# value and separate live credentials and product ids.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Product ids are per environment. Keep test and live ids separate; never use a
# test product id with live credentials. The Free product is optional because
# the Free plan is never sold through checkout.
DODO_PRODUCT_FREE_TEST=
DODO_PRODUCT_STARTER_TEST=
DODO_PRODUCT_PRO_TEST=
DODO_PRODUCT_BUSINESS_TEST=
DODO_PRODUCT_FREE_LIVE=
DODO_PRODUCT_STARTER_LIVE=
DODO_PRODUCT_PRO_LIVE=
DODO_PRODUCT_BUSINESS_LIVE=
